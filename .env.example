# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/taskmanager?schema=public"

# --- Auth (NextAuth / Auth.js) ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-..."
# Only accounts on this Google Workspace domain may sign in
GOOGLE_WORKSPACE_DOMAIN="eraofmarketing.com"
# Optional: comma separated emails that are bootstrapped as ADMIN on first sign-in
BOOTSTRAP_ADMIN_EMAILS="admin@eraofmarketing.com"

# --- Google service account (domain-wide delegation) ---
# JSON key of the service account, base64-encoded (cat key.json | base64 -w0)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=""
# Workspace user the service account impersonates for Drive/Calendar/Chat/Gmail/Sheets
GOOGLE_IMPERSONATE_USER="ops@eraofmarketing.com"
# Drive folder that holds Clients/, Finance/ (created automatically if empty)
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# Google Sheet ids for two-way sync (created automatically if empty)
GOOGLE_FINANCE_SHEET_ID=""
GOOGLE_EXPENSES_SHEET_ID=""
# Set to "true" to disable all Google calls (dev / CI); integrations then run in mock mode
GOOGLE_MOCK="true"

# --- Jobs ---
# Secret required by /api/jobs/* endpoints (Vercel Cron sends it as Authorization: Bearer)
CRON_SECRET="replace-me"
# Run the in-process job loop inside `next dev` (set to "false" on Vercel; use vercel.json crons)
JOBS_INLINE="true"

# --- Vault encryption ---
# 32-byte key, base64 (openssl rand -base64 32)
VAULT_ENCRYPTION_KEY=""

# --- Web push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@eraofmarketing.com"

# --- Company ---
COMPANY_TIMEZONE="Asia/Kolkata"
